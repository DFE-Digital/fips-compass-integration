@* Product masthead — DfE blue; inverse text. Home only. *@
<div class="dfe-f-masthead dfe-f-masthead--product">
    <div class="@FipsLayout.AppShellContainerClass dfe-f-masthead__inner">
        <div class="govuk-grid-row">
            <div class="govuk-grid-column-two-thirds">
                <h1 class="govuk-heading-xl govuk-!-margin-bottom-4">Find information about products and services</h1>
                <p class="govuk-body govuk-!-margin-bottom-4">
                    Use this service to explore what DfE delivers. Build on existing work, avoid duplication, and work more effectively across teams.
                </p>
                <p class="govuk-body govuk-!-margin-bottom-0">
                    <a class="govuk-button govuk-button--inverse" href="@Url.Action("Index", "Products")" data-module="govuk-button">Search</a>
                </p>
            </div>
        </div>
    </div>
</div>
