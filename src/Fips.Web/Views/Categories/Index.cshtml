@model CategoriesIndexViewModel
@{
    ViewData["Title"] = "Categories";
    var groups = Model.LookupGroups.Concat(Model.CategorisationGroups).ToList();
}

<h1 class="govuk-heading-xl">Categories</h1>

@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="govuk-error-summary" role="alert" tabindex="-1">
        <h2 class="govuk-error-summary__title">There is a problem</h2>
        <ul class="govuk-list govuk-error-summary__list">
            <li>@Model.ErrorMessage</li>
        </ul>
    </div>
}
else if (groups.Count == 0)
{
    <p class="govuk-body">No FIPS taxonomy groups returned.</p>
}
else
{
    <div class="fips-category-results govuk-!-margin-bottom-6">
        @for (var i = 0; i < groups.Count; i++)
        {
            var group = groups[i];
            var href = Url.Action("Group", "Categories", new { taxonomyKind = (int)group.TaxonomyKind, groupId = group.GroupId });
            <div class="fips-category-results__item">
                <p class="govuk-body govuk-!-margin-bottom-2">
                    <a class="govuk-link govuk-link--no-visited-state govuk-!-font-weight-bold" href="@href">@group.Title</a>
                </p>
                @if (!string.IsNullOrWhiteSpace(group.Description))
                {
                    <p class="govuk-body govuk-!-margin-bottom-0">@group.Description</p>
                }
            </div>
            @if (i < groups.Count - 1)
            {
                <hr class="govuk-section-break govuk-section-break--visible govuk-!-margin-top-3 govuk-!-margin-bottom-3" />
            }
        }
    </div>
}
